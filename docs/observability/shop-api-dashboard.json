          },
          "expr": "sum by (operation) (increase(shop_products_changes_total{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "shop.cache.requests: hits as a share of all product cache lookups.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(shop_cache_requests_total{service_name=\"$service\",result=\"hit\"}[$__range])) / sum(rate(shop_cache_requests_total{service_name=\"$service\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": true
        }
      ]
    },
